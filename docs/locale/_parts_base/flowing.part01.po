#: flowing.tool.Image:29 of
msgid ":func:`flowing.tool.normalize_output` —— 载体 → 块的唯一转换点。"
msgstr ""

#: flowing.tool.Image:30 of
msgid ":class:`flowing.message.ImageBlock` —— 转换产物（消息层）。"
msgstr ""

#: flowing.Image.data:1 flowing.tool.Image.data:1 of
msgid "bytes 原始数据或 str base64；与 ``path`` 至少其一。"
msgstr ""

#: flowing.Image.path:1 flowing.tool.Image.path:1 of
