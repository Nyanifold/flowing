msgstr ""

#: flowing.agent.Agent.enqueue_message:36 flowing.agent.Agent.message:30 of
msgid ":meth:`query` —— 等待语义的封装。"
msgstr ""

#: flowing.agent.Agent.message:31 of
msgid ":meth:`steer` —— STEER 优先级的特例。"
msgstr ""

#: flowing.agent.Agent.message:32 of
msgid ":meth:`enqueue_message` —— 被委托的原始入队入口。"
msgstr ""

#: flowing.agent.Agent.steer:1 of
msgid "注入 steer 消息（不等回应）：``message(..., priority=MessagePriority.STEER)`` 的特例。"
msgstr ""

#: flowing.agent.Agent.steer:6 of
msgid ""
"回合进行中向 Agent 追加导向信息（补充约束、修正方向、追加资料）。 固定 ``priority=MessagePriority.STEER"
"``，fire-and-forget，返回 ``message_id``。"
msgstr ""

#: flowing.agent.Agent.steer:18 of
msgid ""
"吸收语义：STEER 消息的两个消费路径——随出队批次进入回合 （队首 INTERRUPT/STEER 连续段并入下一逻辑回合的消费批次， 见 "
