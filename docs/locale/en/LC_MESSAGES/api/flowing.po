msgstr ""

#: flowing.agent.Agent.query:42 of
msgid ":meth:`cancel_queued` —— 撤回未出队消息。"
msgstr ""

#: flowing.agent.Agent.query:43 of
msgid ":meth:`side_query` —— 副线路径。"
msgstr ""

#: flowing.agent.Agent.message:1 of
msgid "散装直接入队（fire-and-forget），返回 ``message_id``，不等待结果。"
msgstr ""

