msgstr "The ``--key value`` arguments passed through to ``launch`` and the subproject ``main``."

#: flowing.interfaces.repl.cmd_repl:118 of
msgid ":data:`EXIT_OK` （正常退出）或 :data:`EXIT_RUNTIME_ERROR` （``launch`` 失败）。"
msgstr ":data:`EXIT_OK` (normal exit) or :data:`EXIT_RUNTIME_ERROR` (``launch`` failed)."

#: flowing.interfaces.repl.cmd_repl:123 of
msgid ":data:`SLASH_COMMANDS`"
msgstr ":data:`SLASH_COMMANDS`"

#: flowing.interfaces.repl.cmd_repl:124 of
msgid "封闭命令集。"
msgstr "The closed command set."

#: flowing.interfaces.repl.cmd_repl:125 of
msgid ":meth:`flowing.agent.Agent.query`"
msgstr ":meth:`flowing.agent.Agent.query`"

#: flowing.interfaces.repl.cmd_repl:126 of
msgid "打包 + 入队 + 等待回合结果，repl 的唯一投递通道。"
msgstr "Packing + enqueueing + awaiting the turn result — the repl's sole delivery channel."

#: flowing.interfaces.repl.cmd_repl:127 of
msgid ":meth:`flowing.runtime.Runtime.get_agent`"
msgstr ":meth:`flowing.runtime.Runtime.get_agent`"

#: flowing.interfaces.repl.cmd_repl:128 of
